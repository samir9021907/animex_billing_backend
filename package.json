{
  "name": "animex-billing-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/app.js",
  "type": "commonjs",
  "scripts": {
    "postinstall": "npx puppeteer browsers install chrome",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
